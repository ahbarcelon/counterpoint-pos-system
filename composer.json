{
    "name": "school/pos-system",
    "description": "IT0049 CodeIgniter 4 Point-of-Sale system",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7.5",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Tests\\Support\\": "tests/_support/"
        },
        "exclude-from-classmap": ["app/Database/Migrations/"]
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php spark serve"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "codeigniter4/translations": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
